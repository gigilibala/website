---
import { Icon } from 'astro-icon/components'
import { NAME, NAV_LINKS, SOCIALS } from '../data/site'
import { isActive } from '../lib/nav'

const { pathname } = Astro.url
---

<header class='sticky top-0 z-30 border-b border-rule bg-paper/85 backdrop-blur-md'>
  <div class='mx-auto flex h-16 max-w-5xl items-center justify-between gap-6 px-5'>
    <a
      href='/'
      class='font-display text-xl font-bold tracking-tight text-pine'
      aria-current={pathname === '/' ? 'page' : undefined}
    >
      {NAME}
    </a>

    <button
      id='menu-button'
      type='button'
      class='-mr-2 rounded-md p-2 text-pine md:hidden'
      aria-expanded='false'
      aria-controls='site-nav'
      aria-label='Open menu'
    >
      <Icon name='lucide:menu' class='menu-open size-6' />
      <Icon name='lucide:x' class='menu-close hidden size-6' />
    </button>

    <nav
      id='site-nav'
      class='absolute inset-x-0 top-16 hidden border-b border-rule bg-paper px-5 pb-6 md:static md:flex md:items-center md:gap-8 md:border-0 md:bg-transparent md:p-0'
    >
      <ul class='flex flex-col md:flex-row md:items-center md:gap-6'>
        {NAV_LINKS.map(({ href, label }) => {
          const active = isActive(pathname, href)
          return (
            <li>
              <a
                href={href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'block border-b border-rule py-3 text-base font-medium transition-colors md:border-0 md:py-1',
                  'md:border-b-2 md:border-transparent hover:text-pine',
                  active
                    ? 'text-pine md:border-amber!'
                    : 'text-ink/75 dark:text-ink/80',
                ]}
              >
                {label}
              </a>
            </li>
          )
        })}
      </ul>

      <ul class='mt-5 flex items-center gap-4 md:mt-0 md:border-l md:border-rule md:pl-6'>
        {SOCIALS.map(({ href, label, icon }) => (
          <li>
            <a
              href={href}
              target='_blank'
              rel='noopener noreferrer'
              aria-label={label}
              title={label}
              class='block text-lichen transition-colors hover:text-pine'
            >
              <Icon name={`simple-icons:${icon}`} class='size-5' />
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const button = document.getElementById('menu-button')!
  const nav = document.getElementById('site-nav')!

  function setOpen(open: boolean) {
    button.setAttribute('aria-expanded', String(open))
    button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu')
    button.querySelector('.menu-open')!.classList.toggle('hidden', open)
    button.querySelector('.menu-close')!.classList.toggle('hidden', !open)
    nav.classList.toggle('hidden', !open)
  }

  button.addEventListener('click', () =>
    setOpen(button.getAttribute('aria-expanded') !== 'true'),
  )
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false)
  })
</script>
