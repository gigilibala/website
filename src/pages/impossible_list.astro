---
import { Icon } from 'astro-icon/components'
import { IMPOSSIBLE_LIST } from '../data/impossible'
import Base from '../layouts/Base.astro'

const all = IMPOSSIBLE_LIST.flatMap((g) => g.goals)
const doneCount = all.filter((g) => g.done).length
---

<Base
  title='Impossible list'
  page='impossible_list'
  description='Goals big enough that Amin is not sure he can reach them, and the ones already crossed off.'
>
  <div class='measure space-y-6'>
    <h1>Impossible list</h1>
    <p>
      An{' '}
      <a class='link' href='https://impossiblehq.com/impossible-list'>
        impossible list
      </a>{' '}
      is more than a bucket list. It’s a set of goals so big that I’m not sure I
      can reach them. I keep mine here to hold myself accountable, and to come
      back once in a while to cross some off and pick the next adventure.
    </p>
    <p class='text-lichen'>
      {doneCount} of {all.length} crossed off so far.
    </p>
  </div>

  <div class='mt-14 columns-1 gap-12 md:columns-2'>
    {IMPOSSIBLE_LIST.map((group) => {
      const done = group.goals.filter((g) => g.done).length
      return (
        <section class='mb-12 break-inside-avoid'>
          <h2 class='flex items-baseline justify-between gap-4 border-b border-rule pb-2'>
            {group.title}
            <span class='font-sans text-base font-normal tabular-nums text-lichen'>
              {done}/{group.goals.length}
            </span>
          </h2>
          <ul class='mt-3 space-y-2'>
            {group.goals.map((goal) => (
              <li class='flex gap-3'>
                {goal.done ? (
                  <Icon
                    name='lucide:circle-check'
                    class='mt-1 size-5 shrink-0 text-amber'
                    aria-label='Done'
                  />
                ) : (
                  <Icon
                    name='lucide:circle'
                    class='mt-1 size-5 shrink-0 text-rule'
                    aria-hidden='true'
                  />
                )}
                <span>
                  <span
                    class:list={[
                      goal.done &&
                        'text-lichen line-through decoration-amber/60',
                    ]}
                  >
                    {goal.text}
                  </span>
                  {goal.raisedFrom && (
                    <span class='text-lichen'>
                      {' '}
                      (raised from <s>{goal.raisedFrom}</s>)
                    </span>
                  )}
                  {goal.done && (
                    <span class='block text-base text-ink'>
                      {goal.url ? (
                        <a class='link' href={goal.url}>
                          {goal.done}
                        </a>
                      ) : (
                        goal.done
                      )}
                    </span>
                  )}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    })}
  </div>
</Base>
